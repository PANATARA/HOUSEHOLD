# =================================================================
# HOUSEHOLD Backend Environment Configuration Example
# Скопируйте этот файл в .env перед запуском:
# cp .env.example .env
# =================================================================

# --- База данных PostgreSQL (для Docker Compose) ---
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=postgres
DB_HOST=pgdb
DB_PORT=5432

# URL для подключения приложения к базе данных
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres_db:5432/postgres
TEST_DATABASE_URL=postgresql+asyncpg://test:test@test_db:5444/test

# --- Redis (очереди задач) ---
REDIS_URL=redis://redis:6379

# --- JWT авторизация и токены сессии ---
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# --- S3 Хранилище (опционально для загрузки изображений) ---
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT_URL=https://s3.storage.selcloud.ru
S3_BUCKET_NAME=household-storage

# --- Настройки хоста и раздачи PWA-фронтенда ---
BASE_URL=localhost:8000
SERVE_FRONTEND=True

# --- Google OAuth / Identity Services (GIS) ---
# Web Client ID из Google Cloud Console / Firebase Authentication
# Пример: 123456789012-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# --- Firebase Cloud Messaging (FCM) для Push-уведомлений ---
# Вариант 1: путь к файлу сервисного аккаунта (положите файл рядом и укажите путь)
FCM_CREDENTIALS_PATH=./serviceAccountKey.json
# Вариант 2: или сырой JSON ключ строкой
FCM_CREDENTIALS_JSON=
